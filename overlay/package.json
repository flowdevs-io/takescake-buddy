{
  "name": "mtga-overlay",
  "productName": "MTGA Tracker",
  "version": "2.0.9",
  "description": "MTG Arena Draw Odds Overlay",
  "author": "MTGA Tracker",
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/rebuild-overlay-window.js && electron .",
    "overlay:rebuild": "node ./scripts/rebuild-overlay-window.js",
    "overlay:rebuild:x64": "node ./scripts/rebuild-overlay-window.js x64",
    "overlay:rebuild:arm64": "node ./scripts/rebuild-overlay-window.js arm64",
    "backend:build": "node ./scripts/build-backend.js",
    "scraper:build": "node ./scripts/build-scraper.js",
    "package": "node ./scripts/build-electron.js --dir",
    "package:x64": "node ./scripts/build-electron.js --dir --x64",
    "package:arm64": "node ./scripts/build-electron.js --dir --arm64",
    "make": "node ./scripts/build-electron.js --win",
    "make:x64": "node ./scripts/build-electron.js --win --x64",
    "make:arm64": "node ./scripts/build-electron.js --win --arm64"
  },
  "build": {
    "appId": "com.mtgatracker.app",
    "productName": "MTGA Tracker",
    "icon": "build/icon.png",
    "files": [
      "**/*",
      "!dist-app{,/**/*}",
      "!dist-release{,/**/*}"
    ],
    "directories": {
      "output": "dist-app"
    },
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-overlay-window": "^4.0.2"
  }
}
